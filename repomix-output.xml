<file path="api/utils/verifyUser.js">
import jwt from 'jsonwebtoken';
import { errorHandler } from './error.js';

/**
 * Normalizes input role variations to standard canonical roles: 'citizen' | 'agent' | 'admin'
 */
export const normalizeRole = (role) => {
  if (!role) return 'citizen';
  const r = String(role).trim().toLowerCase();
  if (r === 'user' || r === 'citizen') return 'citizen';
  if (r === 'agent') return 'agent';
  if (
    r === 'admin' ||
    r === 'government_officer' ||
    r === 'government officer' ||
    r === 'gov_auditor'
  ) {
    return 'admin';
  }
  return 'citizen';
};

/**
 * Verifies JWT token from cookies or Authorization Bearer header and attaches normalized user info to req.user
 */
export const verifyUser = (req, res, next) => {
  const token =
    req.cookies?.access_token ||
    (req.headers?.authorization && req.headers.authorization.startsWith('Bearer ')
      ? req.headers.authorization.split(' ')[1]
      : null);

  if (!token) {
    const authError = errorHandler
      ? errorHandler(401, 'Unauthorized: Access token is missing')
      : new Error('Unauthorized');
    return typeof next === 'function'
      ? next(authError)
      : res.status(401).json({ success: false, message: 'Unauthorized' });
  }

  const secret = process.env.JWT_SECRET || 'civicestate_jwt_secret_key_2081';

  jwt.verify(token, secret, (err, decodedUser) => {
    if (err) {
      const forbiddenError = errorHandler
        ? errorHandler(403, 'Forbidden: Invalid or expired token')
        : new Error('Forbidden');
      return typeof next === 'function'
        ? next(forbiddenError)
        : res.status(403).json({ success: false, message: 'Forbidden' });
    }

    req.user = {
      ...decodedUser,
      id: decodedUser.id || decodedUser._id,
      role: normalizeRole(decodedUser.role),
    };

    if (typeof next === 'function') {
      return next();
    }
  });
};

export const verifyToken = verifyUser;

/**
 * Role-Based Access Control (RBAC) middleware factory
 * Supports factory invocation: authorizeRoles('admin') as well as direct middleware fallback
 */
export const authorizeRoles = (...allowedRoles) => {
  // Defensive guard: if middleware was passed directly without invocation (req, res, next)
  if (
    allowedRoles.length > 0 &&
    typeof allowedRoles[0] === 'object' &&
    allowedRoles[0]?.headers
  ) {
    const req = allowedRoles[0];
    const res = allowedRoles[1];
    const next = allowedRoles[2];

    if (!req.user) {
      const authErr = errorHandler
        ? errorHandler(401, 'Unauthorized: User not authenticated')
        : new Error('Unauthorized');
      return typeof next === 'function'
        ? next(authErr)
        : res.status(401).json({ success: false, message: 'Unauthorized' });
    }
    return typeof next === 'function' ? next() : undefined;
  }

  const normalizedAllowedRoles = allowedRoles.map((r) => normalizeRole(r));

  return (req, res, next) => {
    if (!req.user) {
      const authErr = errorHandler
        ? errorHandler(401, 'Unauthorized: User not authenticated')
        : new Error('Unauthorized');
      return typeof next === 'function'
        ? next(authErr)
        : res.status(401).json({ success: false, message: 'Unauthorized' });
    }

    const userRole = normalizeRole(req.user.role);

    if (
      normalizedAllowedRoles.length > 0 &&
      !normalizedAllowedRoles.includes(userRole)
    ) {
      const roleErr = errorHandler
        ? errorHandler(
            403,
            `Forbidden: Requires [${allowedRoles.join(', ')}] clearance`
          )
        : new Error('Forbidden: Insufficient privileges');
      return typeof next === 'function'
        ? next(roleErr)
        : res.status(403).json({ success: false, message: 'Forbidden' });
    }

    if (typeof next === 'function') {
      return next();
    }
  };
};
